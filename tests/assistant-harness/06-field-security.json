{
  "format": "assistant-harness.v1",
  "name": "field-security",
  "description": "Field-level security and the engine's checks in the dry run: a field the member cannot read does not exist for the assistant, one they cannot change is refused by label, and validation rules, required values, uniqueness and indexed filters speak their messages.",
  "steps": [
    {"note": "a field the member cannot read is unknown",
     "call": {"operation": {"name": "update", "object": "custom:account", "record": "${acme}", "values": {"custom:salary": "1"}}},
     "expect": {"error": "assistant.invalid", "message": "Some details need to change before I can do that.",
                "matches": {"/error/fields/0": {"field": "custom:salary", "message": "That field isn't available."}},
                "never_contains": ["Salary", "90000"]}},
    {"note": "and cannot be filtered on",
     "call": {"operation": {"name": "list", "object": "custom:account", "conditions": [{"test": "is_empty", "field": "custom:salary"}]}},
     "expect": {"error": "assistant.invalid"}},
    {"note": "or sorted by",
     "call": {"operation": {"name": "list", "object": "custom:account", "sort": {"field": "custom:salary"}}},
     "expect": {"error": "assistant.invalid", "matches": {"/error/fields/0": {"field": "custom:salary", "label": "custom:salary", "message": "Assistants can't sort on that."}},
                "never_contains": ["Salary"]}},
    {"note": "a field that does not exist answers the same way, naming only what was asked",
     "call": {"operation": {"name": "list", "object": "custom:account", "sort": {"field": "custom:nothing"}}},
     "expect": {"error": "assistant.invalid", "matches": {"/error/fields/0": {"field": "custom:nothing", "label": "custom:nothing", "message": "Assistants can't sort on that."}}}},
    {"note": "a field that cannot be sorted on",
     "call": {"operation": {"name": "list", "object": "custom:account", "sort": {"field": "custom:summary"}}},
     "expect": {"error": "assistant.invalid", "matches": {"/error/fields/0": {"label": "Summary", "message": "Assistants can't sort on that."}}}},
    {"note": "or searched for",
     "call": {"operation": {"name": "search", "text": "90000"}},
     "expect": {"length": {"/result/results": 0}}},
    {"note": "a field the member reads but may not change is refused by label",
     "call": {"operation": {"name": "update", "object": "custom:account", "record": "${acme}", "values": {"custom:rating": 5}}},
     "expect": {"error": "assistant.invalid",
                "matches": {"/error/fields/0": {"field": "custom:rating", "label": "Rating", "message": "Rating can't be changed."}}}},
    {"note": "a validation rule speaks its own message",
     "call": {"operation": {"name": "update", "object": "custom:account", "record": "${acme}", "values": {"custom:amount": -5}}},
     "expect": {"error": "assistant.invalid",
                "matches": {"/error/fields/0": {"field": "custom:amount", "label": "Amount", "message": "Amount can't be negative."}}}},
    {"note": "a required value is asked for by label",
     "call": {"operation": {"name": "create", "object": "custom:account", "values": {"custom:notes": "no name"}}},
     "expect": {"error": "assistant.invalid", "includes": {"/error/fields": {"field": "name", "label": "Name", "message": "Name is required."}}}},
    {"note": "a picklist takes only its values",
     "call": {"operation": {"name": "update", "object": "custom:account", "record": "${acme}", "values": {"custom:stage": "lost"}}},
     "expect": {"error": "assistant.invalid", "includes": {"/error/fields": {"field": "custom:stage", "label": "Stage", "message": "Choose one of the values Stage offers."}}}},
    {"note": "a unique value already taken",
     "call": {"operation": {"name": "create", "object": "custom:account", "values": {"name": "Copy", "custom:code": "ACME"}}},
     "expect": {"error": "assistant.invalid", "message": "Another record already has that value.", "never_contains": ["ACME"]}},
    {"note": "a field that is not indexed cannot be filtered on, by its label",
     "call": {"operation": {"name": "list", "object": "custom:account", "conditions": [{"test": "equals", "field": "custom:summary", "value": "x"}]}},
     "expect": {"error": "assistant.invalid", "matches": {"/error/fields/0": {"label": "Summary", "message": "Assistants can't filter on Summary."}}}},
    {"note": "a test that does not fit the field's type",
     "call": {"operation": {"name": "list", "object": "custom:account", "conditions": [{"test": "contains", "field": "custom:amount", "value": "1"}]}},
     "expect": {"error": "assistant.invalid", "matches": {"/error/fields/0": {"label": "Amount", "message": "Assistants can't filter on Amount that way."}}}},
    {"note": "a value of the wrong type names the field, never the engine's detail",
     "call": {"operation": {"name": "update", "object": "custom:account", "record": "${acme}", "values": {"custom:amount": "lots"}}},
     "expect": {"error": "assistant.invalid", "matches": {"/error/fields/0": {"field": "custom:amount", "message": "Amount isn't valid."}},
                "never_contains": ["lots", "expected"]}},
    {"note": "a search needs something to look for",
     "call": {"operation": {"name": "search", "text": "  "}},
     "expect": {"error": "assistant.invalid", "matches": {"/error/fields/0": {"field": "text", "label": "Search", "message": "Say what to look for."}}}},
    {"note": "a field that does not exist",
     "call": {"operation": {"name": "create", "object": "custom:account", "values": {"name": "X", "custom:nothing": 1}}},
     "expect": {"error": "assistant.invalid", "matches": {"/error/fields/0": {"message": "That field isn't available."}}}}
  ]
}
