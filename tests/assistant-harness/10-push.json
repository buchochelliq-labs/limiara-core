{
  "format": "assistant-harness.v1",
  "name": "push",
  "description": "The push marker and the server's re-check: an assistant's writes push marked with the assistant (and a quick action's object and name), the server records them as the assistant's against its current policy, refuses one it no longer allows with assistant.not_allowed, and leaves the member's own writes alone. A record with both assistant and member edits unsent pushes marked as a whole.",
  "steps": [
    {"note": "an assistant's create",
     "call": {"operation": {"name": "create", "object": "custom:account", "values": {"name": "Initech", "custom:notes": "via the assistant"}}},
     "save": {"token": "/result/token"}},
    {"call": {"operation": {"name": "commit", "token": "${token}"}}, "save": {"initech": "/result/id"}},
    {"note": "pushes marked with the assistant",
     "world": {"action": "push_queue"},
     "expect": {"length": {"/operations": 1},
                "matches": {"/operations/0": {"method": "create", "object": "custom:account", "assistant": {"assistant": "${assistant}"}}},
                "absent": ["/operations/0/assistant/quick_action"]}},
    {"world": {"action": "sync"}, "expect": {"equals": {"/failed": []}}},
    {"note": "the server records the assistant as the source",
     "world": {"action": "server_history", "object": "custom:account", "record": "${initech}"},
     "expect": {"includes": {"/sources": {"kind": "assistant", "detail": "${assistant}"}},
                "excludes": {"/sources": {"kind": "device"}}}},
    {"note": "once pushed, the mark is gone",
     "world": {"action": "push_queue"}, "expect": {"length": {"/operations": 0}}},
    {"note": "a quick action carries its object and name",
     "call": {"operation": {"name": "run_action", "object": "custom:account", "action": "note", "record": "${acme}", "values": {"custom:notes": "Called"}}},
     "save": {"token": "/result/token"}},
    {"call": {"operation": {"name": "commit", "token": "${token}"}}},
    {"world": {"action": "push_queue"},
     "expect": {"matches": {"/operations/0/assistant": {"assistant": "${assistant}", "quick_action": {"object": "custom:account", "name": "note"}}}}},
    {"world": {"action": "sync"}, "expect": {"equals": {"/failed": []}}},
    {"world": {"action": "server_record", "object": "custom:account", "record": "${acme}"},
     "expect": {"equals": {"/values/custom:notes": "Called", "/values/custom:stage": "won"}}},
    {"note": "an assistant's edit and the member's own, unsent on one record: marked as a whole",
     "call": {"operation": {"name": "update", "object": "custom:account", "record": "${acme}", "values": {"custom:notes": "Both"}}},
     "save": {"token": "/result/token"}},
    {"call": {"operation": {"name": "commit", "token": "${token}"}}, "save": {"version": "/result/version"}},
    {"world": {"action": "web", "method": "PATCH", "path": "/objects/custom:account/records/${acme}",
               "body": {"expected_version": "${version}", "custom:amount": 1250}},
     "expect": {"equals": {"/status": 200}}},
    {"world": {"action": "push_queue"},
     "expect": {"length": {"/operations": 1},
                "matches": {"/operations/0": {"method": "update", "assistant": {"assistant": "${assistant}"}}}}},
    {"world": {"action": "sync"}, "expect": {"equals": {"/failed": []}}},
    {"world": {"action": "server_record", "object": "custom:account", "record": "${acme}"},
     "expect": {"equals": {"/values/custom:notes": "Both", "/values/custom:amount": 1250.0}}},
    {"note": "the device writes while the policy allows it; before the push the server's policy changes",
     "call": {"operation": {"name": "update", "object": "custom:account", "record": "${acme}", "values": {"custom:notes": "Offline change"}}},
     "save": {"token": "/result/token"}},
    {"call": {"operation": {"name": "commit", "token": "${token}"}}},
    {"world": {"action": "set_policy", "object": "custom:account", "change": {"writable": false, "offered_actions": []}}},
    {"note": "the server's re-check refuses it",
     "world": {"action": "sync"},
     "expect": {"equals": {"/failed": [{"object": "custom:account", "record": "${acme}", "code": "assistant.not_allowed"}]}}},
    {"world": {"action": "server_record", "object": "custom:account", "record": "${acme}"},
     "expect": {"equals": {"/values/custom:notes": "Both"}}},
    {"note": "the member's own write is not the policy's business",
     "world": {"action": "web", "method": "POST", "path": "/objects/custom:account/records", "body": {"name": "By hand"}},
     "expect": {"equals": {"/status": 201}}, "save": {"by_hand": "/body/id"}},
    {"world": {"action": "push_queue"},
     "expect": {"includes": {"/operations": {"method": "create", "values": {"name": "By hand"}}},
                "excludes": {"/operations": {"values": {"name": "By hand"}, "assistant": {}}}}},
    {"world": {"action": "sync"}, "expect": {"excludes": {"/failed": {"record": "${by_hand}"}}}},
    {"world": {"action": "server_record", "object": "custom:account", "record": "${by_hand}"},
     "expect": {"equals": {"/found": true}}},
    {"note": "an update action on a record not pushed yet still pushes as an assistant's create",
     "world": {"action": "set_policy", "object": "custom:account", "change": {"writable": true, "offered_actions": ["note", "add_branch"]}}},
    {"world": {"action": "sync"}},
    {"world": {"action": "web", "method": "POST", "path": "/objects/custom:account/records", "body": {"name": "Fresh"}},
     "save": {"fresh": "/body/id"}},
    {"call": {"operation": {"name": "run_action", "object": "custom:account", "action": "note", "record": "${fresh}", "values": {"custom:notes": "Called"}}},
     "save": {"token": "/result/token"}},
    {"call": {"operation": {"name": "commit", "token": "${token}"}}},
    {"world": {"action": "push_queue"},
     "expect": {"matches": {"/operations/0": {"method": "create", "assistant": {"assistant": "${assistant}"}}},
                "absent": ["/operations/0/assistant/quick_action"]}},
    {"world": {"action": "sync"}, "expect": {"equals": {"/failed": []}}},
    {"world": {"action": "server_record", "object": "custom:account", "record": "${fresh}"},
     "expect": {"equals": {"/values/custom:notes": "Called", "/values/custom:stage": "won"}}}
  ]
}
