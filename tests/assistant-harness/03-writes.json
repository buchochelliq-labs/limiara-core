{
  "format": "assistant-harness.v1",
  "name": "writes",
  "description": "create, update and run_action through prepare and commit: a prepare writes nothing, the confirmation lists exactly the fields the request sets, and the commit runs the full save path with the assistant as the source.",
  "steps": [
    {"note": "prepare a create",
     "call": {"operation": {"name": "create", "object": "custom:account",
                            "values": {"name": "Globex", "custom:amount": 50, "custom:stage": "won", "custom:parent": "${acme}"}}},
     "expect": {"kind": "confirmation",
                "matches": {"/result": {"write": "create", "object": "custom:account", "object_label": "Account",
                                        "record_name": null, "action_label": null}},
                "includes": {"/result/changes": {"field": "custom:parent", "label": "Parent account", "display": "Acme"}},
                "length": {"/result/changes": 4},
                "present": ["/result/token", "/result/expires_at"]},
     "save": {"create_token": "/result/token"}},
    {"note": "the confirmation's display values",
     "call": {"operation": {"name": "create", "object": "custom:account",
                            "values": {"name": "Globex", "custom:amount": 50, "custom:stage": "won"}}},
     "expect": {"includes": {"/result/changes": {"field": "custom:stage", "value": "won", "display": "Closed won"}},
                "matches": {"/result/changes": [{"field": "custom:amount", "display": "50.00"},
                                                {"field": "custom:stage"},
                                                {"field": "name", "label": "Name", "display": "Globex"}]}}},
    {"note": "a prepare writes nothing: still only Acme",
     "call": {"operation": {"name": "list", "object": "custom:account"}},
     "expect": {"length": {"/result/records": 1}}},
    {"note": "and queues nothing",
     "world": {"action": "push_queue"},
     "expect": {"length": {"/operations": 0}}},
    {"note": "commit the create",
     "call": {"operation": {"name": "commit", "token": "${create_token}"}},
     "expect": {"kind": "committed", "matches": {"/result": {"object": "custom:account", "name": "Globex"}}},
     "save": {"globex": "/result/id"}},
    {"note": "the new record reads back, pointing at Acme",
     "call": {"operation": {"name": "get", "object": "custom:account", "record": "${globex}"}},
     "expect": {"includes": {"/result/fields": {"field": "custom:parent", "value": "${acme}", "display": "Acme"}}}},
    {"note": "history on the device records the assistant",
     "world": {"action": "device_history", "object": "custom:account", "record": "${globex}"},
     "expect": {"includes": {"/sources": {"kind": "assistant", "detail": "${assistant}"}},
                "excludes": {"/sources": {"kind": "device"}}}},
    {"note": "prepare an update: only what changes is confirmed",
     "call": {"operation": {"name": "update", "object": "custom:account", "record": "${acme}",
                            "values": {"custom:notes": "Renewal due", "custom:stage": "open"}}},
     "expect": {"kind": "confirmation",
                "matches": {"/result": {"write": "update", "record_name": "Acme",
                                        "changes": [{"field": "custom:notes", "label": "Notes", "value": "Renewal due", "display": "Renewal due"}]}}},
     "save": {"update_token": "/result/token"}},
    {"note": "an update that changes nothing has nothing to confirm",
     "call": {"operation": {"name": "update", "object": "custom:account", "record": "${acme}", "values": {"custom:stage": "open"}}},
     "expect": {"error": "assistant.invalid", "message": "Nothing would change."}},
    {"note": "commit the update",
     "call": {"operation": {"name": "commit", "token": "${update_token}"}},
     "expect": {"kind": "committed", "equals": {"/result/id": "${acme}", "/result/name": "Acme"}}},
    {"note": "the change is in the replica",
     "world": {"action": "web", "method": "GET", "path": "/objects/custom:account/records/${acme}"},
     "expect": {"equals": {"/body/custom:notes": "Renewal due"}}},
    {"note": "run an update action: its preset applies",
     "call": {"operation": {"name": "run_action", "object": "custom:account", "action": "note", "record": "${acme}",
                            "values": {"custom:notes": "Called"}}},
     "expect": {"kind": "confirmation",
                "matches": {"/result": {"write": "run_action", "record_name": "Acme", "action_label": "Add a note"}},
                "includes": {"/result/changes": {"field": "custom:stage", "value": "won", "display": "Closed won"}}},
     "save": {"note_token": "/result/token"}},
    {"note": "commit it",
     "call": {"operation": {"name": "commit", "token": "${note_token}"}},
     "expect": {"kind": "committed"}},
    {"note": "a value the member gives wins over the preset",
     "call": {"operation": {"name": "run_action", "object": "custom:account", "action": "note", "record": "${acme}",
                            "values": {"custom:notes": "Kept open", "custom:stage": "open"}}},
     "expect": {"includes": {"/result/changes": {"field": "custom:stage", "value": "open", "display": "Open"}}}},
    {"note": "run a create action: the child points at the record",
     "call": {"operation": {"name": "run_action", "object": "custom:account", "action": "add_branch", "record": "${acme}",
                            "values": {"name": "Acme Paris"}}},
     "expect": {"kind": "confirmation", "matches": {"/result": {"write": "run_action", "action_label": "Add branch"}}},
     "save": {"branch_token": "/result/token"}},
    {"note": "commit it",
     "call": {"operation": {"name": "commit", "token": "${branch_token}"}},
     "expect": {"kind": "committed", "equals": {"/result/name": "Acme Paris"}},
     "save": {"branch": "/result/id"}},
    {"note": "the branch has the record as its parent and the preset notes",
     "world": {"action": "web", "method": "GET", "path": "/objects/custom:account/records/${branch}"},
     "expect": {"equals": {"/body/custom:parent": "${acme}", "/body/custom:notes": "branch office"}}},
    {"note": "a field the action's form does not ask for is refused",
     "call": {"operation": {"name": "run_action", "object": "custom:account", "action": "note", "record": "${acme}",
                            "values": {"custom:amount": 1}}},
     "expect": {"error": "assistant.invalid"}},
    {"note": "a create with no values is refused",
     "call": {"operation": {"name": "create", "object": "custom:account", "values": {}}},
     "expect": {"error": "assistant.invalid", "message": "Some details need to change before I can do that."}}
  ]
}
