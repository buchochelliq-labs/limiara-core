{
  "format": "assistant-harness.v1",
  "name": "policy",
  "description": "Policy refusals: the policy only narrows what the member could do. Unexposed objects, actions not offered, objects not writable, the member's own create permission, and the workspace switch and the member's device setting.",
  "steps": [
    {"note": "an unexposed object is refused by its plural label, for every operation",
     "call": {"operation": {"name": "get", "object": "custom:secret", "record": "${vault}"}},
     "expect": {"error": "assistant.object_not_exposed", "message": "Assistants can't reach Secrets in Limiara."},
     "save_document": "secret"},
    {"call": {"operation": {"name": "list", "object": "custom:secret"}}, "expect": {"same_as": "secret"}},
    {"call": {"operation": {"name": "actions", "object": "custom:secret"}}, "expect": {"same_as": "secret"}},
    {"call": {"operation": {"name": "create", "object": "custom:secret", "values": {"name": "New"}}}, "expect": {"same_as": "secret"}},
    {"call": {"operation": {"name": "search", "text": "vault", "object": "custom:secret"}}, "expect": {"same_as": "secret"}},
    {"note": "an object that does not exist names nothing",
     "call": {"operation": {"name": "get", "object": "custom:missing", "record": "x"}},
     "expect": {"error": "assistant.object_not_exposed", "message": "Assistants can't reach those records in Limiara."}},
    {"note": "an action the policy does not offer",
     "call": {"operation": {"name": "run_action", "object": "custom:account", "action": "quiet", "record": "${acme}"}},
     "expect": {"error": "assistant.action_not_offered", "message": "That action isn't available to assistants."},
     "save_document": "not_offered"},
    {"note": "and one that does not exist answer the same",
     "call": {"operation": {"name": "run_action", "object": "custom:account", "action": "missing", "record": "${acme}"}},
     "expect": {"same_as": "not_offered"}},
    {"note": "exposed and writable, but the member may not create regions",
     "call": {"operation": {"name": "create", "object": "custom:region", "values": {"name": "North"}}},
     "expect": {"error": "assistant.not_permitted", "message": "You don't have access to do that in Limiara."}},
    {"note": "describe says so",
     "call": {"operation": {"name": "describe"}},
     "expect": {"includes": {"/result/objects": {"api_name": "custom:region", "can_create": false, "writable": true}}}},
    {"note": "not writable any more: reads work, writes are refused",
     "world": {"action": "set_policy", "object": "custom:account", "change": {"writable": false, "offered_actions": []}}},
    {"world": {"action": "sync"}},
    {"call": {"operation": {"name": "get", "object": "custom:account", "record": "${acme}"}},
     "expect": {"kind": "record"}},
    {"call": {"operation": {"name": "create", "object": "custom:account", "values": {"name": "New"}}},
     "expect": {"error": "assistant.not_writable", "message": "Assistants can't change Accounts in Limiara."}},
    {"call": {"operation": {"name": "update", "object": "custom:account", "record": "${acme}", "values": {"custom:notes": "x"}}},
     "expect": {"error": "assistant.not_writable"}},
    {"call": {"operation": {"name": "run_action", "object": "custom:account", "action": "note", "record": "${acme}", "values": {"custom:notes": "x"}}},
     "expect": {"error": "assistant.action_not_offered"}},
    {"call": {"operation": {"name": "actions", "object": "custom:account"}},
     "expect": {"kind": "actions", "length": {"/result/actions": 0}}},
    {"call": {"operation": {"name": "describe"}},
     "expect": {"includes": {"/result/objects": {"api_name": "custom:account", "writable": false, "actions": []}}}},
    {"note": "not exposed any more: the object leaves describe and search",
     "world": {"action": "set_policy", "object": "custom:account", "change": {"exposed": false, "indexable": false}}},
    {"world": {"action": "sync"}},
    {"call": {"operation": {"name": "describe"}},
     "expect": {"excludes": {"/result/objects": {"api_name": "custom:account"}}}},
    {"call": {"operation": {"name": "search", "text": "acme"}},
     "expect": {"length": {"/result/results": 0}}},
    {"call": {"operation": {"name": "get", "object": "custom:account", "record": "${acme}"}},
     "expect": {"error": "assistant.object_not_exposed", "message": "Assistants can't reach Accounts in Limiara."}},
    {"note": "the workspace switch off: every operation is disabled",
     "world": {"action": "set_switch", "enabled": false}},
    {"world": {"action": "sync"}},
    {"call": {"operation": {"name": "describe"}},
     "expect": {"error": "assistant.disabled", "message": "Assistant access is off for this workspace."}},
    {"call": {"operation": {"name": "commit", "token": "anything"}},
     "expect": {"error": "assistant.disabled"}},
    {"note": "a policy change reaches the device only by sync",
     "world": {"action": "set_switch", "enabled": true}},
    {"call": {"operation": {"name": "describe"}},
     "expect": {"error": "assistant.disabled"}},
    {"world": {"action": "sync"}},
    {"call": {"operation": {"name": "describe"}},
     "expect": {"kind": "description"}},
    {"note": "the member turns assistant access off on this device",
     "world": {"action": "device_settings", "assistant_access": false},
     "expect": {"equals": {"/assistant_access": false, "/indexing": false}}},
    {"call": {"operation": {"name": "describe"}},
     "expect": {"error": "assistant.disabled", "message": "Assistant access is off for this workspace."}},
    {"world": {"action": "device_settings", "assistant_access": true}},
    {"call": {"operation": {"name": "describe"}},
     "expect": {"kind": "description"}}
  ]
}
