{
  "format": "assistant-harness.v1",
  "name": "not-found",
  "description": "No existence leaks: a colleague's record the member cannot read, a record that does not exist and an id that is not an id get byte-for-byte the same answer from every operation that names a record.",
  "steps": [
    {"call": {"operation": {"name": "get", "object": "custom:account", "record": "${hidden}"}},
     "expect": {"error": "assistant.not_found", "message": "I couldn't find that record in Limiara."},
     "save_document": "get"},
    {"call": {"operation": {"name": "get", "object": "custom:account", "record": "zz-9999999999"}}, "expect": {"same_as": "get"}},
    {"call": {"operation": {"name": "get", "object": "custom:account", "record": "not an id"}}, "expect": {"same_as": "get"}},
    {"call": {"operation": {"name": "get", "object": "custom:account", "record": "../${acme}"}}, "expect": {"same_as": "get"}},
    {"call": {"operation": {"name": "timeline", "object": "custom:account", "record": "${hidden}"}},
     "expect": {"same_as": "get"}},
    {"call": {"operation": {"name": "timeline", "object": "custom:account", "record": "zz-9999999999"}}, "expect": {"same_as": "get"}},
    {"call": {"operation": {"name": "actions", "object": "custom:account", "record": "${hidden}"}}, "expect": {"same_as": "get"}},
    {"call": {"operation": {"name": "actions", "object": "custom:account", "record": "zz-9999999999"}}, "expect": {"same_as": "get"}},
    {"call": {"operation": {"name": "update", "object": "custom:account", "record": "${hidden}", "values": {"custom:notes": "x"}}},
     "expect": {"same_as": "get"}},
    {"call": {"operation": {"name": "update", "object": "custom:account", "record": "zz-9999999999", "values": {"custom:notes": "x"}}},
     "expect": {"same_as": "get"}},
    {"call": {"operation": {"name": "run_action", "object": "custom:account", "action": "note", "record": "${hidden}"}},
     "expect": {"same_as": "get"}},
    {"call": {"operation": {"name": "run_action", "object": "custom:account", "action": "note", "record": "not an id"}},
     "expect": {"same_as": "get"}},
    {"note": "a lookup to a record the member cannot read is refused like a missing one",
     "call": {"operation": {"name": "create", "object": "custom:account", "values": {"name": "Child", "custom:parent": "${hidden}"}}},
     "expect": {"error": "assistant.invalid", "never_contains": ["Hidden Co"],
                "matches": {"/error/fields/0": {"field": "custom:parent", "message": "Choose a record Parent account can point at."}}},
     "save_document": "hidden_parent"},
    {"call": {"operation": {"name": "create", "object": "custom:account", "values": {"name": "Child", "custom:parent": "zz-9999999999"}}},
     "expect": {"same_as": "hidden_parent"}},
    {"note": "search and list never show it",
     "call": {"operation": {"name": "search", "text": "Hidden"}},
     "expect": {"length": {"/result/results": 0}}},
    {"call": {"operation": {"name": "list", "object": "custom:account"}},
     "expect": {"excludes": {"/result/records": {"id": "${hidden}"}}}}
  ]
}
