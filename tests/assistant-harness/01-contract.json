{
  "format": "assistant-harness.v1",
  "name": "contract",
  "description": "The wire format: only assistant.v1 JSON from the plugin's own assistant is answered, and anything else is assistant.invalid with its fixed sentence, under the contract version.",
  "steps": [
    {"note": "not JSON at all",
     "call": {"raw": "this is not json", "malformed": true},
     "expect": {"error": "assistant.invalid", "message": "Some details need to change before I can do that.",
                "equals": {"/contract": "assistant.v1"}}},
    {"note": "an operation the contract does not offer: delete",
     "call": {"operation": {"name": "delete", "object": "custom:account", "record": "${acme}"}, "malformed": true},
     "expect": {"error": "assistant.invalid"}},
    {"note": "a field the operation does not take",
     "call": {"operation": {"name": "get", "object": "custom:account", "record": "${acme}", "query": "name != ''"}, "malformed": true},
     "expect": {"error": "assistant.invalid"}},
    {"note": "another contract version",
     "call": {"contract": "assistant.v0", "operation": {"name": "describe"}, "malformed": true},
     "expect": {"error": "assistant.invalid"}},
    {"note": "an assistant outside the closed list",
     "call": {"assistant": "alexa", "operation": {"name": "describe"}, "malformed": true},
     "expect": {"error": "assistant.invalid"}},
    {"note": "the other platform's assistant: well formed, but not the one the shell built the plugin for",
     "call": {"assistant": "${other_assistant}", "operation": {"name": "describe"}},
     "expect": {"error": "assistant.invalid", "message": "Some details need to change before I can do that."}},
    {"note": "query text is never accepted, only typed conditions",
     "call": {"operation": {"name": "list", "object": "custom:account", "conditions": [{"test": "where", "field": "name", "value": "1=1"}]}, "malformed": true},
     "expect": {"error": "assistant.invalid"}},
    {"note": "more than five conditions",
     "call": {"operation": {"name": "list", "object": "custom:account", "conditions": [
        {"test": "is_empty", "field": "name"}, {"test": "is_empty", "field": "name"},
        {"test": "is_empty", "field": "name"}, {"test": "is_empty", "field": "name"},
        {"test": "is_empty", "field": "name"}, {"test": "is_empty", "field": "name"}]}, "malformed": true},
     "expect": {"error": "assistant.invalid", "message": "Use at most 5 conditions."}},
    {"note": "the device lock is checked before anything is read",
     "call": {"device_unlocked": false, "operation": {"name": "describe"}},
     "expect": {"error": "assistant.device_locked", "message": "Unlock your device first."}},
    {"note": "a well-formed request is answered under the contract version",
     "call": {"operation": {"name": "describe"}},
     "expect": {"kind": "description", "equals": {"/contract": "assistant.v1"}}}
  ]
}
