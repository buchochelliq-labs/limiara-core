{
  "format": "assistant-harness.v1",
  "name": "index",
  "description": "The index stream through the member's device setting, writes and deletes, a sync, policy changes and excluded fields, a lease that locks, the workspace switch, sign-out and wipe, and the launch sweep.",
  "steps": [
    {"note": "a plugin takes its stream at launch",
     "index": {"action": "subscribe"}},
    {"note": "indexing is off on the device until the member turns it on",
     "index": {"action": "drain"},
     "expect": {"kinds": []}},
    {"note": "the launch sweep: with indexing off nothing may stay indexed",
     "index": {"action": "sweep", "indexed": ["${workspace}", "${other_workspace}"]},
     "expect": {"length": {"/remove_workspaces": 2}, "present": ["/remove_expired_before"]}},
    {"note": "the member turns indexing on: a rebuild from what they read",
     "world": {"action": "device_settings", "indexing": true}},
    {"index": {"action": "drain"},
     "expect": {"kinds": ["rebuild", "upsert"],
                "matches": {"/updates/0": {"workspace": "${workspace}"},
                            "/updates/1/entry": {"workspace": "${workspace}", "object": "custom:account",
                                                 "object_label": "Account", "record": "${acme}", "name": "Acme"}},
                "includes": {"/updates/1/entry/fields": {"field": "custom:amount", "label": "Amount", "display": "1200.00"}},
                "excludes": {"/updates/1/entry/fields": {"field": "custom:notes"}},
                "never_contains": ["Key account", "90000", "Hidden Co", "Vault", "${hidden}"],
                "present": ["/updates/1/entry/expires_at"]}},
    {"note": "the sweep now keeps the workspace the shell holds",
     "index": {"action": "sweep", "indexed": ["${workspace}", "${other_workspace}"]},
     "expect": {"equals": {"/remove_workspaces": ["${other_workspace}"]}}},
    {"note": "an assistant's write adds an entry",
     "call": {"operation": {"name": "create", "object": "custom:account", "values": {"name": "Umbrella"}}},
     "save": {"token": "/result/token"}},
    {"call": {"operation": {"name": "commit", "token": "${token}"}},
     "save": {"umbrella": "/result/id", "umbrella_version": "/result/version"}},
    {"index": {"action": "drain"},
     "expect": {"kinds": ["upsert"], "matches": {"/updates/0/entry": {"record": "${umbrella}", "name": "Umbrella"}}}},
    {"note": "the member deletes it in the app: the entry goes",
     "world": {"action": "web", "method": "DELETE",
               "path": "/objects/custom:account/records/${umbrella}?expected_version=${umbrella_version}"},
     "expect": {"equals": {"/status": 200}}},
    {"index": {"action": "drain"},
     "expect": {"includes": {"/updates": {"kind": "remove", "workspace": "${workspace}", "object": "custom:account", "record": "${umbrella}"}}}},
    {"note": "a sync that reaches the server moves every entry's expiry",
     "world": {"action": "sync"}},
    {"index": {"action": "drain"},
     "expect": {"equals": {"/refreshes": 1}}},
    {"note": "a colleague's change on the server is pulled and written again",
     "world": {"action": "server_update", "object": "custom:account", "record": "${acme}", "values": {"custom:amount": 1300}}},
    {"world": {"action": "sync"}},
    {"index": {"action": "drain"},
     "expect": {"includes": {"/updates": {"kind": "upsert", "entry": {"record": "${acme}"}}},
                "excludes": {"/updates": {"kind": "remove_workspace"}}}},
    {"call": {"operation": {"name": "get", "object": "custom:account", "record": "${acme}"}},
     "expect": {"includes": {"/result/fields": {"field": "custom:amount", "display": "1300.00"}}}},
    {"note": "excluding the name rewrites the object's entries without it",
     "world": {"action": "set_policy", "object": "custom:account", "change": {"excluded_fields": ["custom:notes", "name"]}}},
    {"world": {"action": "sync"}},
    {"index": {"action": "drain"},
     "expect": {"kinds": ["remove_object", "upsert"],
                "matches": {"/updates/0": {"object": "custom:account"}, "/updates/1/entry": {"record": "${acme}", "name": null}},
                "never_contains": ["Acme"]}},
    {"note": "excluding a field takes it out",
     "world": {"action": "set_policy", "object": "custom:account", "change": {"excluded_fields": ["custom:notes", "custom:amount"]}}},
    {"world": {"action": "sync"}},
    {"index": {"action": "drain"},
     "expect": {"kinds": ["remove_object", "upsert"],
                "excludes": {"/updates/1/entry/fields": {"field": "custom:amount"}},
                "equals": {"/updates/1/entry/name": "Acme"}}},
    {"note": "indexable off removes the object's entries",
     "world": {"action": "set_policy", "object": "custom:account", "change": {"indexable": false}}},
    {"world": {"action": "sync"}},
    {"index": {"action": "drain"},
     "expect": {"kinds": ["remove_object"], "equals": {"/updates/0/object": "custom:account"}}},
    {"world": {"action": "set_policy", "object": "custom:account", "change": {"indexable": true, "excluded_fields": ["custom:notes"]}}},
    {"world": {"action": "sync"}},
    {"index": {"action": "drain"},
     "expect": {"kinds": ["upsert"]}},
    {"note": "a lease that locks keeps the index",
     "world": {"action": "advance_clock", "seconds": 3601}},
    {"world": {"action": "check_lease"}, "expect": {"equals": {"/locked": true}}},
    {"index": {"action": "drain"},
     "expect": {"kinds": []}},
    {"note": "and the sync that opens it again changes nothing but the expiry",
     "world": {"action": "sync"}},
    {"world": {"action": "check_lease"}, "expect": {"equals": {"/locked": false}}},
    {"index": {"action": "drain"},
     "expect": {"kinds": [], "equals": {"/refreshes": 1}}},
    {"note": "the workspace switch off removes the workspace's entries",
     "world": {"action": "set_switch", "enabled": false}},
    {"world": {"action": "sync"}},
    {"index": {"action": "drain"},
     "expect": {"kinds": ["remove_workspace"], "equals": {"/updates/0/workspace": "${workspace}"}}},
    {"world": {"action": "set_switch", "enabled": true}},
    {"world": {"action": "sync"}},
    {"index": {"action": "drain"},
     "expect": {"kinds": ["rebuild", "upsert"]}},
    {"note": "the member turning indexing off removes them too",
     "world": {"action": "device_settings", "indexing": false}},
    {"index": {"action": "drain"},
     "expect": {"kinds": ["remove_workspace"]}},
    {"world": {"action": "device_settings", "indexing": true}},
    {"index": {"action": "drain"},
     "expect": {"kinds": ["rebuild", "upsert"]}},
    {"note": "sign-out clears the workspace's entries before the replica goes",
     "world": {"action": "sign_out"}},
    {"index": {"action": "drain"},
     "expect": {"kinds": ["remove_workspace"], "equals": {"/updates/0/workspace": "${workspace}"}}},
    {"note": "a launch after sign-out sweeps the workspace too",
     "index": {"action": "sweep", "indexed": ["${workspace}"]},
     "expect": {"equals": {"/remove_workspaces": ["${workspace}"]}}},
    {"note": "signing in again rebuilds; the first sync's pull may report the record again, which applies the same entry",
     "world": {"action": "sign_in"}},
    {"index": {"action": "drain"},
     "expect": {"equals": {"/updates/0/kind": "rebuild"},
                "includes": {"/updates": {"kind": "upsert", "entry": {"record": "${acme}", "name": "Acme"}}},
                "excludes": {"/updates": {"kind": "remove_workspace"}}}},
    {"note": "a wipe clears it the same way",
     "world": {"action": "wipe"}},
    {"index": {"action": "drain"},
     "expect": {"kinds": ["remove_workspace"]}},
    {"note": "nothing is left behind for a launch after the wipe",
     "index": {"action": "sweep", "indexed": ["${workspace}", "${other_workspace}"]},
     "expect": {"length": {"/remove_workspaces": 2}}},
    {"note": "a launch that holds the workspace again keeps it and sweeps the rest",
     "world": {"action": "sign_in"}},
    {"index": {"action": "drain"},
     "expect": {"equals": {"/updates/0/kind": "rebuild"},
                "includes": {"/updates": {"kind": "upsert", "entry": {"record": "${acme}"}}}}},
    {"index": {"action": "sweep", "indexed": ["${other_workspace}", "${workspace}", "${other_workspace}"]},
     "expect": {"equals": {"/remove_workspaces": ["${other_workspace}"]}}}
  ]
}
