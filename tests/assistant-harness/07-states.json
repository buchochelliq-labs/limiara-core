{
  "format": "assistant-harness.v1",
  "name": "states",
  "description": "Every state of ADR 0034 §8 in which the replica cannot answer, each with its code and the sentence the member hears: device locked, assistant access off for the workspace or on the device, past the offline lease, storage unavailable, a sign-out in progress, signed out and wiped; and the bridge answering again once the state is over.",
  "steps": [
    {"note": "the device is locked",
     "call": {"device_unlocked": false, "operation": {"name": "get", "object": "custom:account", "record": "${acme}"}},
     "expect": {"error": "assistant.device_locked", "message": "Unlock your device first."}},
    {"note": "assistant access off for the workspace",
     "world": {"action": "set_switch", "enabled": false}},
    {"world": {"action": "sync"}},
    {"call": {"operation": {"name": "describe"}},
     "expect": {"error": "assistant.disabled", "message": "Assistant access is off for this workspace."}},
    {"world": {"action": "set_switch", "enabled": true}},
    {"world": {"action": "sync"}},
    {"note": "assistant access off on this device",
     "world": {"action": "device_settings", "assistant_access": false}},
    {"call": {"operation": {"name": "describe"}},
     "expect": {"error": "assistant.disabled", "message": "Assistant access is off for this workspace."}},
    {"world": {"action": "device_settings", "assistant_access": true}},
    {"note": "past the offline lease, measured by the injectable clock",
     "world": {"action": "advance_clock", "seconds": 3601}},
    {"world": {"action": "check_lease"}, "expect": {"equals": {"/locked": true}}},
    {"call": {"operation": {"name": "get", "object": "custom:account", "record": "${acme}"}},
     "expect": {"error": "assistant.locked", "message": "Open Limiara while online so it can check your access."}},
    {"call": {"operation": {"name": "describe"}},
     "expect": {"error": "assistant.locked"}},
    {"note": "a sync reaches the server and opens the replica again",
     "world": {"action": "sync"}},
    {"world": {"action": "check_lease"}, "expect": {"equals": {"/locked": false}}},
    {"call": {"operation": {"name": "get", "object": "custom:account", "record": "${acme}"}},
     "expect": {"kind": "record"}},
    {"note": "the key or storage cannot be opened",
     "world": {"action": "storage_unavailable"}},
    {"call": {"operation": {"name": "describe"}},
     "expect": {"error": "assistant.unavailable", "message": "Limiara can't open this workspace right now."}},
    {"world": {"action": "sign_in"}},
    {"call": {"operation": {"name": "describe"}},
     "expect": {"kind": "description"}},
    {"note": "a sign-out in progress wins",
     "world": {"action": "begin_sign_out"}},
    {"call": {"operation": {"name": "get", "object": "custom:account", "record": "${acme}"}},
     "expect": {"error": "assistant.signed_out", "message": "Sign in to Limiara on this device first."}},
    {"note": "signed out",
     "world": {"action": "sign_out"}},
    {"call": {"operation": {"name": "describe"}},
     "expect": {"error": "assistant.signed_out", "message": "Sign in to Limiara on this device first."}},
    {"note": "even the device lock is checked first",
     "call": {"device_unlocked": false, "operation": {"name": "describe"}},
     "expect": {"error": "assistant.device_locked"}},
    {"note": "signed in again, on a fresh replica",
     "world": {"action": "sign_in"}},
    {"call": {"operation": {"name": "get", "object": "custom:account", "record": "${acme}"}},
     "expect": {"kind": "record", "equals": {"/result/name": "Acme"}}},
    {"note": "wiped by the server: the same answer, the replica is gone",
     "world": {"action": "wipe"}},
    {"call": {"operation": {"name": "describe"}},
     "expect": {"error": "assistant.signed_out", "message": "Sign in to Limiara on this device first."}},
    {"call": {"operation": {"name": "commit", "token": "anything"}},
     "expect": {"error": "assistant.signed_out"}},
    {"world": {"action": "sign_in"}},
    {"call": {"operation": {"name": "describe"}},
     "expect": {"kind": "description"}}
  ]
}
