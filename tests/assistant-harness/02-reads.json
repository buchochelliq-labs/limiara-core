{
  "format": "assistant-harness.v1",
  "name": "reads",
  "description": "describe, search, get, list with every condition test and a sort, timeline, actions and on_screen, as the member over the replica, with display values formatted by the bridge.",
  "steps": [
    {"note": "describe: only exposed objects the member reads",
     "call": {"operation": {"name": "describe"}},
     "expect": {"kind": "description",
                "includes": {"/result/objects": {"api_name": "custom:account", "label": "Account", "plural_label": "Accounts",
                                                  "writable": true, "can_create": true, "can_edit": true, "timeline": false}},
                "excludes": {"/result/objects": {"api_name": "custom:secret"}}},
     "save_document": "description"},
    {"note": "describe: the account's fields, options and offered actions",
     "call": {"operation": {"name": "describe"}},
     "expect": {"same_as": "description",
                "equals": {"/result/objects/0/api_name": "custom:account"},
                "includes": {"/result/objects/0/fields": {"api_name": "custom:stage", "field_type": "picklist",
                                                          "options": [{"value": "open", "label": "Open"}, {"value": "won", "label": "Closed won"}]},
                             "/result/objects/0/actions": {"name": "add_branch", "kind": "create", "target_object": "custom:account", "fields": ["name"]}},
                "excludes": {"/result/objects/0/fields": {"api_name": "custom:salary"},
                             "/result/objects/0/actions": {"name": "quiet"}},
                "length": {"/result/objects/0/actions": 2}}},
    {"note": "describe: a field the member reads but may not change is read-only",
     "call": {"operation": {"name": "describe"}},
     "expect": {"includes": {"/result/objects/0/fields": {"api_name": "custom:rating", "read_only": true}}}},
    {"note": "search across exposed objects",
     "call": {"operation": {"name": "search", "text": "acme"}},
     "expect": {"kind": "search_results", "length": {"/result/results": 1},
                "matches": {"/result/results/0": {"object": "custom:account", "object_label": "Account", "id": "${acme}", "name": "Acme"}}}},
    {"note": "search leaves unexposed objects out",
     "call": {"operation": {"name": "search", "text": "vault"}},
     "expect": {"kind": "search_results", "length": {"/result/results": 0}}},
    {"note": "search in one object",
     "call": {"operation": {"name": "search", "text": "acme", "object": "custom:account"}},
     "expect": {"kind": "search_results", "length": {"/result/results": 1}}},
    {"note": "get: readable values with display values, never the hidden salary",
     "call": {"operation": {"name": "get", "object": "custom:account", "record": "${acme}"}},
     "expect": {"kind": "record",
                "matches": {"/result": {"object": "custom:account", "object_label": "Account", "id": "${acme}", "name": "Acme"}},
                "includes": {"/result/fields": {"field": "custom:amount", "label": "Amount", "field_type": "currency", "display": "1200.00"}},
                "excludes": {"/result/fields": {"field": "custom:salary"}},
                "never_contains": ["90000"]}},
    {"note": "get: a picklist reads as its label, with its raw value",
     "call": {"operation": {"name": "get", "object": "custom:account", "record": "${acme}"}},
     "expect": {"includes": {"/result/fields": {"field": "custom:stage", "value": "open", "display": "Open"}}}},
    {"note": "list: equals",
     "call": {"operation": {"name": "list", "object": "custom:account", "conditions": [{"test": "equals", "field": "custom:stage", "value": "open"}]}},
     "expect": {"kind": "records", "length": {"/result/records": 1}, "equals": {"/result/records/0/name": "Acme"}}},
    {"note": "list: not_equals",
     "call": {"operation": {"name": "list", "object": "custom:account", "conditions": [{"test": "not_equals", "field": "custom:stage", "value": "won"}]}},
     "expect": {"kind": "records", "length": {"/result/records": 1}}},
    {"note": "list: contains",
     "call": {"operation": {"name": "list", "object": "custom:account", "conditions": [{"test": "contains", "field": "name", "value": "cm"}]}},
     "expect": {"kind": "records", "length": {"/result/records": 1}}},
    {"note": "list: before",
     "call": {"operation": {"name": "list", "object": "custom:account", "conditions": [{"test": "before", "field": "custom:amount", "value": 1000}]}},
     "expect": {"kind": "records", "length": {"/result/records": 0}}},
    {"note": "list: after",
     "call": {"operation": {"name": "list", "object": "custom:account", "conditions": [{"test": "after", "field": "custom:amount", "value": 1000}]}},
     "expect": {"kind": "records", "length": {"/result/records": 1}}},
    {"note": "list: between, both ends included",
     "call": {"operation": {"name": "list", "object": "custom:account", "conditions": [{"test": "between", "field": "custom:amount", "from": 1000, "to": 1200}]}},
     "expect": {"kind": "records", "length": {"/result/records": 1}}},
    {"note": "list: is_empty",
     "call": {"operation": {"name": "list", "object": "custom:account", "conditions": [{"test": "is_empty", "field": "custom:parent"}]}},
     "expect": {"kind": "records", "length": {"/result/records": 1}}},
    {"note": "list: a value is a literal, never query text",
     "call": {"operation": {"name": "list", "object": "custom:account", "conditions": [{"test": "equals", "field": "name", "value": "acme' OR name != '"}]}},
     "expect": {"kind": "records", "length": {"/result/records": 0}}},
    {"note": "list: one sort, and a cursor",
     "call": {"operation": {"name": "list", "object": "custom:account", "sort": {"field": "custom:amount", "descending": true}, "cursor": null}},
     "expect": {"kind": "records", "length": {"/result/records": 1}, "equals": {"/result/next_cursor": null}}},
    {"note": "list: a test that does not fit the field is invalid",
     "call": {"operation": {"name": "list", "object": "custom:account", "conditions": [{"test": "before", "field": "custom:stage", "value": "open"}]}},
     "expect": {"error": "assistant.invalid"}},
    {"note": "timeline: replicas carry no timeline sources yet",
     "call": {"operation": {"name": "timeline", "object": "custom:account", "record": "${acme}"}},
     "expect": {"kind": "timeline", "length": {"/result/open": 0, "/result/past": 0}}},
    {"note": "actions on the object: only the offered ones",
     "call": {"operation": {"name": "actions", "object": "custom:account"}},
     "expect": {"kind": "actions", "length": {"/result/actions": 2},
                "includes": {"/result/actions": {"name": "note", "label": "Add a note", "kind": "update"}}}},
    {"note": "actions on a record",
     "call": {"operation": {"name": "actions", "object": "custom:account", "record": "${acme}"}},
     "expect": {"kind": "actions", "length": {"/result/actions": 2}}},
    {"note": "on_screen: nothing shown yet",
     "call": {"operation": {"name": "on_screen"}},
     "expect": {"kind": "on_screen", "equals": {"/result/object": null, "/result/record": null}}},
    {"note": "the web shell shows the account",
     "world": {"action": "web", "method": "POST", "path": "/ui/route",
               "body": {"route": "record", "object": "custom:account", "record_id": "${acme}"}},
     "expect": {"equals": {"/status": 204}}},
    {"note": "on_screen: an exposed object's record, as ids",
     "call": {"operation": {"name": "on_screen"}},
     "expect": {"kind": "on_screen", "equals": {"/result/workspace": "${workspace}", "/result/object": "custom:account", "/result/record": "${acme}"}}},
    {"note": "the web shell shows the secret",
     "world": {"action": "web", "method": "POST", "path": "/ui/route",
               "body": {"route": "record", "object": "custom:secret", "record_id": "${vault}"}},
     "expect": {"equals": {"/status": 204}}},
    {"note": "on_screen: an unexposed object is not passed on",
     "call": {"operation": {"name": "on_screen"}},
     "expect": {"kind": "on_screen", "equals": {"/result/object": null, "/result/record": null}, "never_contains": ["${vault}"]}}
  ]
}
