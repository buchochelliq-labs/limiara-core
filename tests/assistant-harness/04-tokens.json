{
  "format": "assistant-harness.v1",
  "name": "tokens",
  "description": "The confirmation token's lifecycle: single use, two minutes on the injectable clock, refused when the record or the metadata moved, and garbage tokens never commit.",
  "steps": [
    {"call": {"operation": {"name": "update", "object": "custom:account", "record": "${acme}", "values": {"custom:notes": "First"}}},
     "expect": {"kind": "confirmation"}, "save": {"first": "/result/token"}},
    {"call": {"operation": {"name": "create", "object": "custom:account", "values": {"name": "Dry"}}},
     "expect": {"kind": "confirmation"}, "save": {"dry": "/result/token"}},
    {"note": "used: the first commit wins",
     "call": {"operation": {"name": "commit", "token": "${first}"}},
     "expect": {"kind": "committed"}},
    {"note": "a used token is refused",
     "call": {"operation": {"name": "commit", "token": "${first}"}},
     "expect": {"error": "assistant.confirmation_invalid",
                "message": "That confirmation is no longer valid. Ask again to make the change."}},
    {"note": "garbage: empty",
     "call": {"operation": {"name": "commit", "token": ""}},
     "expect": {"error": "assistant.confirmation_invalid"}},
    {"note": "garbage: not a token",
     "call": {"operation": {"name": "commit", "token": "garbage"}},
     "expect": {"error": "assistant.confirmation_invalid"}},
    {"note": "garbage: a token's id with another secret",
     "call": {"operation": {"name": "commit", "token": "${dry}AAAA"}},
     "expect": {"error": "assistant.confirmation_invalid"}},
    {"note": "garbage: control characters and unicode",
     "call": {"operation": {"name": "commit", "token": "\u0000é😀"}},
     "expect": {"error": "assistant.confirmation_invalid"}},
    {"note": "garbage: a token is never a number",
     "call": {"operation": {"name": "commit", "token": 12}, "malformed": true},
     "expect": {"error": "assistant.invalid"}},
    {"note": "the dry run wrote nothing",
     "call": {"operation": {"name": "search", "text": "Dry"}},
     "expect": {"length": {"/result/results": 0}}},
    {"note": "expired: two minutes and a second later",
     "world": {"action": "advance_clock", "seconds": 121}},
    {"call": {"operation": {"name": "commit", "token": "${dry}"}},
     "expect": {"error": "assistant.confirmation_invalid"}},
    {"note": "a token used just inside its two minutes still commits",
     "call": {"operation": {"name": "create", "object": "custom:account", "values": {"name": "In time"}}},
     "expect": {"kind": "confirmation"}, "save": {"in_time": "/result/token"}},
    {"world": {"action": "advance_clock", "seconds": 119}},
    {"call": {"operation": {"name": "commit", "token": "${in_time}"}},
     "expect": {"kind": "committed"}},
    {"note": "a value computed at read time (the NOW() formula) is not a change",
     "call": {"operation": {"name": "update", "object": "custom:account", "record": "${acme}", "values": {"custom:notes": "Timeless"}}},
     "expect": {"kind": "confirmation"}, "save": {"timeless": "/result/token"}},
    {"call": {"operation": {"name": "get", "object": "custom:account", "record": "${acme}"}},
     "expect": {"includes": {"/result/fields": {"field": "custom:seen_at", "field_type": "formula"}}}},
    {"world": {"action": "advance_clock", "seconds": 1}},
    {"call": {"operation": {"name": "commit", "token": "${timeless}"}},
     "expect": {"kind": "committed"}},
    {"note": "stale record: the member changed it in the app after the assistant prepared",
     "call": {"operation": {"name": "update", "object": "custom:account", "record": "${acme}", "values": {"custom:notes": "Mine"}}},
     "expect": {"kind": "confirmation"}, "save": {"mine": "/result/token"}},
    {"world": {"action": "web", "method": "GET", "path": "/objects/custom:account/records/${acme}"},
     "save": {"version": "/body/version"}},
    {"world": {"action": "web", "method": "PATCH", "path": "/objects/custom:account/records/${acme}",
               "body": {"expected_version": "${version}", "custom:notes": "Theirs"}},
     "expect": {"equals": {"/status": 200}}},
    {"call": {"operation": {"name": "commit", "token": "${mine}"}},
     "expect": {"error": "assistant.confirmation_stale",
                "message": "Something changed since you confirmed. Ask again to make the change."}},
    {"note": "the member's own change stands",
     "call": {"operation": {"name": "get", "object": "custom:account", "record": "${acme}"}},
     "expect": {"includes": {"/result/fields": {"field": "custom:notes", "value": "Theirs"}}}},
    {"note": "a stale token is spent",
     "call": {"operation": {"name": "commit", "token": "${mine}"}},
     "expect": {"error": "assistant.confirmation_invalid"}},
    {"note": "stale record: a colleague changed it on the server and the device pulled it",
     "call": {"operation": {"name": "update", "object": "custom:account", "record": "${acme}", "values": {"custom:notes": "Mine again"}}},
     "expect": {"kind": "confirmation"}, "save": {"pulled": "/result/token"}},
    {"world": {"action": "sync"}},
    {"world": {"action": "server_update", "object": "custom:account", "record": "${acme}", "values": {"custom:amount": 1500}}},
    {"world": {"action": "sync"}, "expect": {"equals": {"/failed": []}}},
    {"call": {"operation": {"name": "commit", "token": "${pulled}"}},
     "expect": {"error": "assistant.confirmation_stale"}},
    {"note": "stale metadata: the definitions moved",
     "call": {"operation": {"name": "update", "object": "custom:account", "record": "${acme}", "values": {"custom:notes": "Later"}}},
     "expect": {"kind": "confirmation"}, "save": {"later": "/result/token"}},
    {"world": {"action": "relabel", "object": "custom:account", "label": "Customer"}},
    {"world": {"action": "sync"}},
    {"call": {"operation": {"name": "commit", "token": "${later}"}},
     "expect": {"error": "assistant.confirmation_stale"}},
    {"note": "the new label is what the next confirmation names",
     "call": {"operation": {"name": "update", "object": "custom:account", "record": "${acme}", "values": {"custom:notes": "Relabelled"}}},
     "expect": {"equals": {"/result/object_label": "Customer"}}, "save": {"relabelled": "/result/token"}},
    {"note": "another assistant cannot commit it",
     "call": {"assistant": "${other_assistant}", "operation": {"name": "commit", "token": "${relabelled}"}},
     "expect": {"error": "assistant.invalid"}},
    {"note": "sign-out forgets every prepared change",
     "world": {"action": "sign_out"}},
    {"world": {"action": "sign_in"}},
    {"call": {"operation": {"name": "commit", "token": "${relabelled}"}},
     "expect": {"error": "assistant.confirmation_invalid"}}
  ]
}
