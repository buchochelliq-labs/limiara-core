# Web shell origin. The shell calls the API with relative /api/v1/... and
# /auth/... URLs, so this server proxies those paths to the API and serves the
# single-page app for every other route. Rendered by the nginx image's
# envsubst step: only ${API_UPSTREAM} and ${NGINX_RESOLVER} are substituted.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Re-resolve the API through the container DNS so an API restart or
    # recreation does not leave nginx pinned to a stale address.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    set $api_upstream http://${API_UPSTREAM};

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;

    location /api/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 30s;
        client_max_body_size 2m;
    }

    location /auth/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }

    # Hashed build assets: cache forever, and never fall back to the app.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options nosniff always;
    }

    # Deep links such as /contacts/people/{id} load the app shell, which
    # resolves the route against the workspace's enabled contributions.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy same-origin always;
    }
}
