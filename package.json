{
  "name": "platform-monorepo",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "docs:check": "pnpm --filter docs quality",
    "validate-ui-metadata": "node scripts/validate-ui-metadata.mjs",
    "test:contacts-visual": "node scripts/run-contacts-visual.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "typescript": "5.6.3",
    "vue": "3.5.40",
    "vitest": "2.1.4"
  }
}
