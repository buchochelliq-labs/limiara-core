<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Content-free pushes wake the app for a short sync (ADR 0030 §5). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- Export compliance (docs/operations/testflight.md): the app ships its
	     own standard encryption, SQLCipher with vendored OpenSSL for the
	     replica and rustls for TLS, not only the encryption built into iOS.
	     YES is the accurate declaration; App Store Connect then asks for
	     the encryption questions once, and Apple's compliance code, when
	     one is issued, goes in ITSEncryptionExportComplianceCode. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<true/>
</dict>
</plist>
