<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Content-free pushes wake the app for a short sync (ADR 0030 §5). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- Export compliance (docs/operations/testflight.md): the app ships its
	     own standard encryption (SQLCipher with vendored OpenSSL for the
	     replica, rustls for TLS), nothing proprietary. The account holder
	     answered App Store Connect's encryption questions (standard
	     algorithms, not distributed in France), which concluded that no
	     documentation is needed, and chose to declare that here so builds
	     are not asked again. Revisit before distributing in France. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
